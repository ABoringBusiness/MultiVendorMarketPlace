# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database (Existing - Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/marketplace
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
DB_USER=postgres
DB_PASS=your_password
DB_NAME=postgres
DB_HOST=localhost

# JWT Authentication (Existing - will be gradually phased out)
JWT_SECRET=your_jwt_secret_key_here

# Stripe Payment Integration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Client URL
CLIENT_URL=http://localhost:5000

# Convex Configuration (NEW)
# Get these values from https://dashboard.convex.dev after creating a project
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=

# Note: During migration, both PostgreSQL and Convex will run simultaneously
# Once migration is complete, PostgreSQL can be deprecated
